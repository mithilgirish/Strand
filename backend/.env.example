# ── LLM Provider ────────────────────────────────────────────
GROQ_API_KEY="your_groq_api_key_here"
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-20b"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_RETRY_COUNT=3

# ── Neo4j (Knowledge Graph) ─────────────────────────────────
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"
NEO4J_DATABASE=""
AURA_INSTANCEID=""
AURA_INSTANCENAME=""

# ── Redis (Caching & Agent State) ───────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── API & Security ──────────────────────────────────────────
API_KEY="strand-dev-key"
DEMO_MODE="False"
BACKEND_URL="http://localhost:8000"
CORS_ORIGINS="https://strand-iota.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081"
APS_WEBHOOK_SECRET="strand-fallback-webhook-secret-98765"

# ── Supabase (Auth & Database) ───────────────────────────────
SUPABASE_URL="https://<project_ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
SUPABASE_JWT_SECRET="your_jwt_secret_here"
NEXT_PUBLIC_SUPABASE_URL="https://<project_ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# ── Frontend & Callback URLs ─────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ── Procore Configuration ───────────────────────────────────
PROCORE_CLIENT_ID="your_procore_client_id"
PROCORE_AUTH_URL="https://login-sandbox.procore.com"
PROCORE_API_URL="https://sandbox.procore.com"
PROCORE_CLIENT_SECRET="your_procore_client_secret"

# ── Autodesk APS Configuration ──────────────────────────────
APS_CLIENT_ID="your_aps_client_id"
APS_CLIENT_SECRET="your_aps_client_secret"
