# ── LLM Provider ────────────────────────────────────────────
# Obtain a free API key from https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"

# (Optional) If you switch LLM_PROVIDER to "anthropic"
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

LLM_PROVIDER="groq"
LLM_MODEL="llama3-8b-8192"

# ── Neo4j (Knowledge Graph) ─────────────────────────────────
# For local Docker: "bolt://localhost:7687"
# For AuraDB cloud: "neo4j+s://<db_id>.databases.neo4j.io"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"

# ── Redis (Caching & Agent State) ───────────────────────────
# If left blank or connection fails, backend falls back to an in-memory dictionary.
REDIS_URL="redis://localhost:6379/0"

# ── API & Security ──────────────────────────────────────────
# Static key used to authenticate critical write actions
API_KEY="strand-dev-key"

# Set to True to auto-approve HITL (Human-in-the-loop) gates during testing
DEMO_MODE="True"
