# ── LLM Provider ────────────────────────────────────────────
# Obtain a free API key from https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"

# (Optional) If you switch LLM_PROVIDER to "anthropic"
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

LLM_PROVIDER="groq"
LLM_MODEL="llama3-8b-8192"

# ── Neo4j (Knowledge Graph) ─────────────────────────────────
# For local Docker: "bolt://localhost:7687"
# For AuraDB cloud: "neo4j+s://<db_id>.databases.neo4j.io"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"

# ── Redis (Caching & Agent State) ───────────────────────────
# If left blank or connection fails, backend falls back to an in-memory dictionary.
REDIS_URL="redis://localhost:6379/0"

# ── API & Security ──────────────────────────────────────────
# Static key used to authenticate critical write actions — CHANGE THIS IN PRODUCTION
API_KEY="strand-dev-key"

# Set to True to auto-approve HITL (Human-in-the-loop) gates during testing — set False in production
DEMO_MODE="False"

# ── Supabase (Auth & Database) ───────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project_ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
# JWT Secret from: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET="your_jwt_secret_here"

# ── Frontend URLs ────────────────────────────────────────────
# Used for auth email redirects (password reset links etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Backend API base URL (FastAPI)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ── Mobile (Expo) ─────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL="https://<project_ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
